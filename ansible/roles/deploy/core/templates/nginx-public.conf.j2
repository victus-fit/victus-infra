server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    try_files $uri =404;
  }

  location / {
    return 404;
  }
}

{% for vhost in core_vhosts | selectattr('exposure', 'equalto', 'public') %}
{% if vhost.http.enabled | default(true) %}
server {
  listen 80;
  server_name {{ vhost.domains | join(' ') }};

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    try_files $uri =404;
  }

{% if vhost.api_upstream is defined and not (vhost.http.redirect_to_https | default(false)) %}
  location ^~ /api/ {
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    set $upstream {{ vhost.api_upstream }};
    proxy_pass http://$upstream;
  }

{% endif %}
  location / {
{% if vhost.http.redirect_to_https | default(false) %}
    return 301 https://$host$request_uri;
{% else %}
{% if vhost.preserve_host | default(false) %}
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
{% endif %}
    proxy_set_header X-Forwarded-Proto $scheme;
    set $upstream {{ vhost.upstream }};
    proxy_pass http://$upstream;
{% endif %}
  }
}

{% endif %}
{% endfor %}
{% if core_tls_enabled | bool %}
{% for vhost in core_vhosts | selectattr('exposure', 'equalto', 'public') %}
{% if vhost.https.enabled | default(false) %}
server {
  listen 443 ssl;
  server_name {{ vhost.domains | join(' ') }};

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  ssl_certificate /etc/letsencrypt/live/{{ core_cert_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ core_cert_name }}/privkey.pem;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

{% if vhost.api_upstream is defined %}
  location ^~ /api/ {
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    set $upstream {{ vhost.api_upstream }};
    proxy_pass http://$upstream;
  }

{% endif %}
  location / {
{% if vhost.preserve_host | default(false) %}
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
{% endif %}
    proxy_set_header X-Forwarded-Proto $scheme;
    set $upstream {{ vhost.upstream }};
    proxy_pass http://$upstream;
  }
}

{% endif %}
{% endfor %}
{% endif %}
