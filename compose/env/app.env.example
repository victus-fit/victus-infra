# Released image references. Replace these tags through the runtime environment.
VICTUS_BACKEND_IMAGE=ghcr.io/victus-fit/victus-backend:replace-me
VICTUS_FRONTEND_IMAGE=ghcr.io/victus-fit/victus-frontend:replace-me
VICTUS_AGENT_IMAGE=ghcr.io/victus-fit/victus-agent:replace-me
VICTUS_RAG_IMAGE=ghcr.io/victus-fit/victus-rag:replace-me

APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:5173
APP_POSTGRES_DB=victus_app
APP_POSTGRES_USER=victus
APP_POSTGRES_PASSWORD=change-me
APP_DATABASE_URL=postgresql://victus:change-me@app-postgres:5432/victus_app
AGENT_POSTGRES_DB=victus_agent
AGENT_POSTGRES_USER=victus
AGENT_POSTGRES_PASSWORD=change-me
AGENT_DATABASE_URL=postgresql+psycopg://victus:change-me@agent-postgres:5432/victus_agent

BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=5173
APP_POSTGRES_BIND_IP=127.0.0.1
APP_POSTGRES_PORT=5432
AGENT_POSTGRES_BIND_IP=127.0.0.1
AGENT_POSTGRES_PORT=5433
QDRANT_BIND_IP=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
PHOENIX_BIND_IP=127.0.0.1
PHOENIX_PORT=6006
AGENT_CHAT_BIND_IP=127.0.0.1
AGENT_CHAT_PORT=8766
AGENT_MCP_BIND_IP=127.0.0.1
AGENT_MCP_PORT=8765

# Populate application secrets in compose/projects/app/.env (local) or Infisical (production).
BETTER_AUTH_SECRET=
SECRET_KEY=
VICTUS_DEMO_JWT_PRIVATE_KEY_PEM_BASE64=
VICTUS_DEMO_JWT_JWKS_JSON=
VICTUS_DEMO_AGENT_API_TOKEN=
VICTUS_DEMO_STATE_API_TOKEN=
VICTUS_RAG_API_TOKEN=
LITELLM_PROXY_API_KEY=
LITELLM_KEY=
HF_TOKEN=
